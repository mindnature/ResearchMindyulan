# Optional LLM configuration. The pipeline runs without an LLM in deterministic demo mode.
# Values: auto | gemini | openai_compatible
RM_YULAN_LLM_PROVIDER=auto
RM_YULAN_LLM_TIMEOUT=60

# Native Gemini API. Either RM_YULAN_GEMINI_API_KEY or GEMINI_API_KEY is accepted.
RM_YULAN_GEMINI_API_KEY=
RM_YULAN_GEMINI_MODEL=
RM_YULAN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible Chat Completions API.
RM_YULAN_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
RM_YULAN_LLM_API_KEY=
RM_YULAN_LLM_MODEL=

# Optional OpenAlex configuration.
# Keyless casual use works; an API key increases the daily budget.
OPENALEX_API_KEY=
OPENALEX_TIMEOUT=30

# Optional Crossref DOI verification.
# Crossref recommends identifying polite API use with an email address.
CROSSREF_MAILTO=
CROSSREF_TIMEOUT=20

# Runtime
RM_YULAN_RUNS_DIR=runs
